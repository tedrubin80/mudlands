# --- Dependencies & build artifacts ---
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache
*.tgz
*.tar.gz
build/
dist/
.cache
.parcel-cache
coverage/
.nyc_output/
test-results/

# --- Environment / secrets (never commit) ---
.env
.env.*
!.env.example

# --- Credentials, certs, keys ---
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*

# --- Operational scripts (should not live in source repo) ---
# Decision: shell scripts contain environment-specific paths, sudo
# operations, and have historically leaked plaintext credentials.
# Keep them out of the public repo. See docs/DECISIONS.md.
*.sh

# --- SQL files that touch credentials ---
# Catch-all for the credential-rotation pattern that leaked in the
# May 2026 incident. See docs/SECURITY_INCIDENT_2026-05.md.
*password*.sql
*-creds*.sql
fix-db-*.sql

# --- Database / backups ---
*.sqlite
*.db
*.backup
*.bak
backup/
backups/
*.dump

# --- Logs / runtime ---
logs/
*.log
pids
*.pid
*.seed
*.pid.lock
sessions/

# --- Editor / OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Media that bloats the repo ---
# Walkthroughs and feature recordings live in releases / external storage,
# not in source. See docs/PORTFOLIO_MANAGEMENT.md for hosting decisions.
*.mp4
*.mov
Screenshot*.png
